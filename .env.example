# Copy to .env.local. Values below match compose.yaml.

# Runtime connection: the espacios_app login, subject to row-level security.
DATABASE_URL=postgresql://espacios_app:espacios_app@localhost:5432/espacios
# Schema owner: migrations, Prisma Studio, seeds and cross-tenant system jobs (operator-wide metrics).
DATABASE_OWNER_URL=postgresql://espacios:espacios@localhost:5432/espacios
