# Copy to .env.local. Values below match compose.yaml and infra/local/postgres/01-roles.sql.
# After pulling a change to the roles, recreate the local database once: docker compose down -v

# Companies: the espacios_app login (member of espacios_runtime). Row-level security applies.
DATABASE_URL=postgresql://espacios_app:espacios_app@localhost:5432/espacios
# Schema owner, not a superuser: migrations, seeds and Prisma Studio. FORCE row-level security applies to it too,
# so Studio shows no bookings unless a tenant is set. Point Studio at DATABASE_OPERATOR_URL to browse every company.
DATABASE_OWNER_URL=postgresql://espacios_owner:espacios_owner@localhost:5432/espacios
# The operator's read-only login (BYPASSRLS, SELECT only): metrics and the global view.
DATABASE_OPERATOR_URL=postgresql://espacios_operator:espacios_operator@localhost:5432/espacios
