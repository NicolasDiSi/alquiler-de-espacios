{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build", "generate"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck", "generate"]
    },
    "test": {
      "outputs": ["coverage/**"],
      "dependsOn": ["generate"]
    },
    "dev": {
      "dependsOn": ["^generate"],
      "cache": false,
      "persistent": true
    },
    "generate": {
      "outputs": ["src/generated/**"]
    },
    "e2e": {
      "dependsOn": ["build"],
      "cache": false,
      "outputs": ["playwright-report/**"]
    },
    "e2e:bookings": {
      "dependsOn": ["build"],
      "cache": false
    },
    "e2e:shell": {
      "dependsOn": ["build"],
      "cache": false
    },
    "e2e:operator": {
      "dependsOn": ["build"],
      "cache": false
    }
  }
}
